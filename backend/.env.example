APP_NAME="LearnHub LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# The React SPA origin. Used for CORS, password-reset links and Stripe redirect URLs.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP MariaDB 10.4
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# "public" for local uploads (served via /storage), switch to "s3" in production.
FILESYSTEM_DISK=public

QUEUE_CONNECTION=database

CACHE_STORE=database

# Bearer tokens issued by Sanctum expire after this many minutes (null = never).
SANCTUM_TOKEN_EXPIRATION=10080

# Emails are written to storage/logs/laravel.log during development.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@learnhub.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3 (optional, production uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Anthropic Claude API — used ONLY by the backend, never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TIMEOUT=60

# Per-user request limits for AI endpoints (requests per minute / per day).
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=100

# Lesson videos: private disk ("local" = storage/app/private, or "s3"), max size in KB,
# and how long signed playback URLs stay valid (minutes).
LESSON_VIDEO_DISK=local
LESSON_VIDEO_MAX_KB=512000
LESSON_VIDEO_URL_TTL=240
